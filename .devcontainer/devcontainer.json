{
  "name": "CPP Base",
  "image": "localhost/cppbase:latest",

  "runArgs": [
    "--userns=keep-id"
  ],

  // 1. Uncomment this. It tells VS Code to use the existing 'vscode' user 
  // (if it exists in your image) which usually has a writable home directory.
  "containerUser": "vscode",

  // 2. Add this. It ensures VS Code updates the internal user's UID 
  // to match your host UID (1000) if they differ, preventing permission issues.
  "updateRemoteUserUID": true,

  "remoteEnv": {
    // 3. Force HOME to be the user's home, NOT /app.
    // Use /home/vscode if the user is 'vscode', or /root if running as root (not recommended with keep-id).
    "HOME": "/home/vscode",
    "PATH": "${containerEnv:PATH}:/home/vscode/.local/bin"
  }
}